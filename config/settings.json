{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_doc": [
    "Configuración base de Claude Code para los estudiantes del Ecomdrop Bootcamp. La fusiona scripts/configurar-claude.mjs con ~/.claude/settings.json.",
    "allow: herramientas de desarrollo y lectura/escritura en ~/proyectos sin preguntar. ask: lo destructivo pero legítimo. deny: lo que nunca se hace.",
    "La guardia (hook PreToolUse) cubre lo que un patrón no puede: rm -rf fuera del proyecto y .env de otros proyectos. Ver docs/permisos.md.",
    "bypassPermissions queda desactivado en este equipo. Solo se usa dentro de un dev container (docs/permisos.md)."
  ],
  "language": "Español",
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(brew *)",
      "Bash(winget *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python3 -m pip *)",
      "Bash(docker *)",
      "Bash(python3 sie/scripts/*)",
      "Bash(python3 sie/skills/*)",
      "Bash(bash sie/bin/*)",
      "Bash(bash sie/scripts/*)",
      "Bash(node sie/scripts/*)",
      "Bash(node sie/skills/*)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(whisper-cli *)",
      "Bash(shopify theme *)",
      "Bash(ecomdrop-doctor)",
      "Bash(ecomdrop-doctor *)",
      "PowerShell(npm *)",
      "PowerShell(npx *)",
      "PowerShell(pnpm *)",
      "PowerShell(node *)",
      "PowerShell(git *)",
      "PowerShell(gh *)",
      "PowerShell(winget *)",
      "PowerShell(uv *)",
      "PowerShell(uvx *)",
      "PowerShell(pip *)",
      "PowerShell(docker *)",
      "PowerShell(ecomdrop-doctor *)",
      "Read(~/proyectos/**)",
      "Edit(~/proyectos/**)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh secret *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(brew uninstall *)",
      "Bash(winget uninstall *)",
      "Bash(shopify theme publish *)",
      "Bash(shopify theme delete *)",
      "Bash(shopify theme push *)",
      "PowerShell(git push --force *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(winget uninstall *)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf ..*)",
      "Bash(sudo rm *)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain *)",
      "Bash(security export *)",
      "Bash(secret-tool *)",
      "Bash(cmdkey *)",
      "PowerShell(cmdkey *)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(~/AppData/Local/Microsoft/Credentials/**)",
      "Read(~/AppData/Roaming/Microsoft/Protect/**)",
      "Read(~/AppData/Local/Microsoft/Vault/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.claude.json)",
      "Read(~/.ecomdrop/.env)",
      "Edit(~/.ecomdrop/**)",
      "Edit(~/.claude/settings.json)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ECOMDROP_HOME}/guardia/guardia.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
