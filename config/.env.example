# Variables del kit Ecomdrop Bootcamp / SIE.
# El asistente de instalación escribe este archivo como .env (nunca se sube a git).
# Formato: una clave por línea, sin comillas y sin comentarios en la misma línea.

# ── Obligatorias ─────────────────────────────────────────────
# kie.ai: imágenes (gpt-image-2), voz (Gemini TTS), música e image-to-video.
# Dónde se consigue: https://kie.ai → API Keys.  La usan: clonar-oferta-es, estaticos-meta, ugc-a-landing, editor-video, landing-infografias
KIE_API_KEY=

# ── Opcionales ───────────────────────────────────────────────
# Apify: voz del cliente y scraping en investigar-producto. Se envía al MCP `apify` como cabecera Authorization.
# Dónde se consigue: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Ruta al modelo de whisper-cli. Por defecto: ~/whisper-models/ggml-large-v3-turbo.bin (lo descarga el setup).
WHISPER_MODEL=

# Binario de chrome-headless-shell / Chrome si Playwright no lo encuentra solo (lo usan scripts/sie_pw.js y validate_render).
PW_EXE=
PW_CHROME=

# Locale de las capturas de landings.
SIE_LOCALE=es-CO

# Avanzadas (normalmente vacías)
# Endpoint de subida de archivos de kie.ai; vacío = el valor por defecto del script.
KIE_UPLOAD_URL=
# Ruta alternativa a un .env con KIE_API_KEY.
KIE_ENV_FILE=
